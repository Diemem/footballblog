---
const links = [
  { label: "Home", href: "/" },
  { label: "Blog", href: "/blog" },
  { label: "Analysis", href: "/category/analysis" },
  { label: "Rankings", href: "/category/rankings" },
  { label: "Opinion", href: "/category/opinion" },
  { label: "About", href: "/about" },
];

// Simple active matcher
const isActive = (href: string, path: string) => {
  if (href === "/") return path === "/";
  if (href === "/blog") return path === "/blog" || path.startsWith("/blog/");
  return path === href || path.startsWith(href + "/");
};
---

<header class="bg-white bg-opacity-95 backdrop-blur-md shadow-lg border-b border-gray-200 sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center py-4">
      <!-- Logo -->
      <div class="flex items-center">
        <a
          href="/"
          class="text-2xl font-bold bg-gradient-to-r from-blue-600 to-purple-600 bg-clip-text text-transparent hover:from-blue-700 hover:to-purple-700 transition-all duration-300"
          aria-label="Football Central home"
        >
          ⚽ Football Central
        </a>
      </div>

      <!-- Desktop Navigation -->
      <nav class="hidden md:flex space-x-6" aria-label="Primary navigation">
        {links.map((l) => (
          <a
            href={l.href}
            class={`text-gray-700 font-medium transition-colors duration-200 relative group ${
              isActive(l.href, Astro.url.pathname) ? "text-blue-700 font-semibold" : "hover:text-blue-600"
            }`}
          >
            {l.label}
            <span
              class={`absolute bottom-0 left-0 h-0.5 bg-blue-600 transition-all duration-200 ${
                isActive(l.href, Astro.url.pathname) ? "w-full" : "w-0 group-hover:w-full"
              }`}
            ></span>
          </a>
        ))}
      </nav>

      <!-- Mobile menu button -->
      <div class="md:hidden">
        <button
          type="button"
          id="mobile-menu-button"
          class="text-gray-700 hover:text-blue-600 transition-colors duration-200 p-2"
          aria-label="Toggle mobile menu"
          aria-controls="mobile-menu"
          aria-expanded="false"
        >
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Navigation Menu -->
    <div id="mobile-menu" class="md:hidden hidden bg-white bg-opacity-95 backdrop-blur-md border-t border-gray-200">
      <nav class="px-4 py-4 space-y-3" aria-label="Mobile navigation">
        {links.map((l) => (
          <a
            href={l.href}
            class={`block text-gray-700 font-medium transition-colors duration-200 py-2 border-b border-gray-100 ${
              isActive(l.href, Astro.url.pathname) ? "text-blue-700 font-semibold" : "hover:text-blue-600"
            }`}
          >
            {l.label}
          </a>
        ))}
      </nav>
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    const btn = document.getElementById("mobile-menu-button");
    const menu = document.getElementById("mobile-menu");
    if (!btn || !menu) return;

    const pathEl = btn.querySelector("svg path");

    const setExpanded = (open) => {
      btn.setAttribute("aria-expanded", open ? "true" : "false");
      if (pathEl) {
        pathEl.setAttribute("d", open ? "M6 18L18 6M6 6l12 12" : "M4 6h16M4 12h16M4 18h16");
      }
    };

    const openMenu = () => {
      menu.classList.remove("hidden");
      setExpanded(true);
    };

    const closeMenu = () => {
      menu.classList.add("hidden");
      setExpanded(false);
    };

    btn.addEventListener("click", () => {
      const isHidden = menu.classList.contains("hidden");
      if (isHidden) openMenu();
      else closeMenu();
    });

    // Close on link click
    menu.querySelectorAll("a").forEach((a) => a.addEventListener("click", closeMenu));

    // Close on outside click
    document.addEventListener("click", (event) => {
      const target = event.target;
      if (!target) return;
      if (!btn.contains(target) && !menu.contains(target)) closeMenu();
    });

    // Close on Escape
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") closeMenu();
    });
  })();
</script>
