---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import AdSlot from "../../components/AdSlot.astro";
import { slugify } from "../../utils/slugify";

const POSTS_PER_PAGE = 6;

export async function getStaticPaths() {
  const allPosts = await getCollection("posts");
  const sortedPosts = allPosts.sort(
    (a, b) =>
      new Date(b.data.publishedAt).getTime() - new Date(a.data.publishedAt).getTime()
  );

  const totalPages = Math.ceil(sortedPosts.length / POSTS_PER_PAGE);

  return Array.from({ length: totalPages }, (_, i) => {
    const page = i + 1;
    const startIndex = (page - 1) * POSTS_PER_PAGE;
    const endIndex = startIndex + POSTS_PER_PAGE;

    return {
      params: { page: String(page) },
      props: {
        page,
        totalPages,
        allPosts: sortedPosts,
        paginatedPosts: sortedPosts.slice(startIndex, endIndex),
      },
    };
  });
}

const { page, totalPages, allPosts, paginatedPosts } = Astro.props;

// Featured posts (take top 6 so page 1 doesn't repeat too much)
const featuredPosts = allPosts.filter((p) => p.data.featured).slice(0, 6);

// Unique categories
const categories = [...new Set(allPosts.map((p) => p.data.category))];

// Canonical: /blog for page 1, otherwise /blog/2, etc.
const canonical = page === 1 ? "/blog" : `/blog/${page}`;
---

<Layout
  title={`Blog - Football Central`}
  description="Latest football analysis, rankings, and evergreen insights."
  canonical={canonical}
>
  <Header />

  <main>
    <!-- Hero Section -->
    <section class="relative py-20 overflow-hidden">
      <div
        class="absolute inset-0"
        style="background-image: url('/images/pexels-eric-masengesho-2154894489-33471345.jpg'); background-size: cover; background-position: center;"
      ></div>
      <div class="absolute inset-0 bg-gradient-to-r from-black via-transparent to-black opacity-70"></div>

      <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <div class="flex items-center justify-center space-x-4 mb-6">
          <div class="text-5xl animate-bounce">⚽</div>
          <h1 class="text-4xl md:text-6xl font-bold text-white drop-shadow-lg">
            Football Central Blog
          </h1>
          <div class="text-5xl animate-bounce" style="animation-delay: 0.5s;">⚽</div>
        </div>

        <p class="text-xl md:text-2xl mb-8 text-gray-100 drop-shadow-md">
          Latest news, analysis, and insights from the world of football
        </p>

        <!-- Stats -->
        <div class="flex flex-wrap justify-center gap-8 mb-8">
          <div class="bg-white bg-opacity-20 backdrop-blur-sm rounded-lg px-6 py-4">
            <div class="text-3xl font-bold text-white">{allPosts.length}</div>
            <div class="text-gray-200">Articles</div>
          </div>
          <div class="bg-white bg-opacity-20 backdrop-blur-sm rounded-lg px-6 py-4">
            <div class="text-3xl font-bold text-white">{categories.length}</div>
            <div class="text-gray-200">Categories</div>
          </div>
          <div class="bg-white bg-opacity-20 backdrop-blur-sm rounded-lg px-6 py-4">
            <div class="text-3xl font-bold text-white">
              {allPosts.filter((p) => p.data.featured).length}
            </div>
            <div class="text-gray-200">Featured</div>
          </div>
        </div>

        <!-- Category Filter -->
        <div class="flex flex-wrap justify-center gap-3">
          <a
            href="/blog"
            class="bg-white text-blue-600 px-6 py-3 rounded-lg font-medium hover:bg-gray-100 transition-all duration-200 shadow-lg"
          >
            All Posts
          </a>

          {categories.map((category) => (
            <a
              href={`/category/${slugify(category)}`}
              class="bg-blue-500 bg-opacity-90 text-white px-6 py-3 rounded-lg font-medium hover:bg-blue-600 transition-all duration-200 backdrop-blur-sm shadow-lg"
            >
              {category}
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Ad Slot - Top of page (USE NUMERIC SLOT ID) -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <AdSlot slot="1234567890" height={250} className="my-8" />
    </div>

    <!-- Featured Posts (only show on page 1) -->
    {page === 1 && featuredPosts.length > 0 && (
      <section class="py-16 bg-gradient-to-br from-blue-50 to-purple-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="text-center mb-12">
            <h2 class="text-4xl font-bold text-gray-900">Featured Articles</h2>
            <p class="text-gray-600 text-lg mt-2">
              Our most popular and in-depth football analysis
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {featuredPosts.slice(0, 3).map((post) => (
              <article class="group bg-white rounded-2xl shadow-lg overflow-hidden hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2">
                <div class="p-6">
                  <div class="flex items-center justify-between mb-3">
                    <span class="text-sm font-medium text-blue-600 bg-blue-50 px-3 py-1 rounded-full">
                      {post.data.category}
                    </span>
                    <span class="text-sm text-gray-500">{post.data.readTime} min read</span>
                  </div>

                  <h3 class="text-xl font-bold text-gray-900 mb-3 group-hover:text-blue-600 transition-colors line-clamp-2">
                    <a href={`/blog/${post.slug}`}>{post.data.title}</a>
                  </h3>

                  <p class="text-gray-600 mb-4 line-clamp-3">{post.data.description}</p>

                  <div class="flex items-center justify-between">
                    <time
                      class="text-sm text-gray-500"
                      datetime={new Date(post.data.publishedAt).toISOString()}
                    >
                      {new Date(post.data.publishedAt).toLocaleDateString("en-GB")}
                    </time>
                    <a href={`/blog/${post.slug}`} class="text-blue-600 font-medium hover:text-blue-700 text-sm">
                      Read More →
                    </a>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- Ad Slot - Middle (USE NUMERIC SLOT ID) -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <AdSlot slot="0987654321" height={250} className="my-8" />
    </div>

    <!-- All Posts -->
    <section class="py-16 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-4xl font-bold text-gray-900">All Articles</h2>
          <p class="text-gray-600 text-lg mt-2">
            Showing {Math.min(page * POSTS_PER_PAGE, allPosts.length)} of {allPosts.length}
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {paginatedPosts.map((post) => (
            <article class="group bg-white rounded-xl shadow-md overflow-hidden hover:shadow-xl transition-all duration-300 border border-gray-100 hover:border-blue-200">
              <div class="p-6">
                <div class="flex items-center justify-between mb-3">
                  <span class="text-sm font-medium text-blue-600 bg-blue-50 px-3 py-1 rounded-full">
                    {post.data.category}
                  </span>
                  <span class="text-sm text-gray-500">{post.data.readTime} min read</span>
                </div>

                <h3 class="text-xl font-bold text-gray-900 mb-3 group-hover:text-blue-600 transition-colors line-clamp-2">
                  <a href={`/blog/${post.slug}`}>{post.data.title}</a>
                </h3>

                <p class="text-gray-600 mb-4 line-clamp-3">{post.data.description}</p>

                {post.data.tags && (
                  <div class="flex flex-wrap gap-2 mb-4">
                    {post.data.tags.slice(0, 3).map((tag: string) => (
                      <span class="bg-gray-100 text-gray-600 px-2 py-1 rounded text-xs">
                        #{tag}
                      </span>
                    ))}
                  </div>
                )}

                <div class="flex items-center justify-between">
                  <time
                    class="text-sm text-gray-500"
                    datetime={new Date(post.data.publishedAt).toISOString()}
                  >
                    {new Date(post.data.publishedAt).toLocaleDateString("en-GB")}
                  </time>
                  <a href={`/blog/${post.slug}`} class="text-blue-600 font-medium hover:text-blue-700 text-sm">
                    Read More →
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>

        <!-- Pagination -->
        <div class="flex justify-center items-center gap-3 mt-12 flex-wrap">
          <a
            href={page > 1 ? (page === 2 ? "/blog" : `/blog/${page - 1}`) : "#"}
            class={page > 1
              ? "px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors"
              : "px-4 py-2 bg-gray-300 text-gray-500 rounded-lg cursor-not-allowed"}
            aria-disabled={page <= 1}
          >
            ← Previous
          </a>

          {Array.from({ length: totalPages }, (_, i) => i + 1).map((p) => (
            <a
              href={p === 1 ? "/blog" : `/blog/${p}`}
              class={p === page
                ? "px-4 py-2 bg-blue-600 text-white rounded-lg font-semibold"
                : "px-4 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition-colors"}
            >
              {p}
            </a>
          ))}

          <a
            href={page < totalPages ? `/blog/${page + 1}` : "#"}
            class={page < totalPages
              ? "px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors"
              : "px-4 py-2 bg-gray-300 text-gray-500 rounded-lg cursor-not-allowed"}
            aria-disabled={page >= totalPages}
          >
            Next →
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
