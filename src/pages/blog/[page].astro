---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import AdSlot from "../../components/AdSlot.astro";
import { slugify } from "../../utils/slugify";

export async function getStaticPaths() {
  const POSTS_PER_PAGE = 6;
  
  const allPosts = await getCollection("posts");
  const sortedPosts = allPosts.sort(
    (a, b) =>
      new Date(b.data.publishedAt).getTime() - new Date(a.data.publishedAt).getTime()
  );

  const totalPages = Math.ceil(sortedPosts.length / POSTS_PER_PAGE);

  return Array.from({ length: totalPages }, (_, i) => {
    const page = i + 1;
    const startIndex = (page - 1) * POSTS_PER_PAGE;
    const endIndex = startIndex + POSTS_PER_PAGE;

    return {
      params: { page: String(page) },
      props: {
        page,
        totalPages,
        allPosts: sortedPosts,
        posts: sortedPosts.slice(startIndex, endIndex),
      },
    };
  });
}

const { page, totalPages, allPosts, posts } = Astro.props;
const categories = [...new Set(allPosts.map((post) => post.data.category))];
---

<Layout 
  title={`Blog - Page ${page} | Football Central`}
  description="Latest football analysis, rankings, and expert commentary on the beautiful game."
>
  <Header />
  
  <main>
    <!-- Hero Section -->
    <section class="relative py-20 overflow-hidden">
      <div
        class="absolute inset-0"
        style="background-image: url('/images/pexels-eric-masengesho-2154894489-33471345.jpg'); background-size: cover; background-position: center;"
      ></div>
      <div class="absolute inset-0 bg-gradient-to-r from-blue-600 to-purple-700 opacity-80"></div>
      
      <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h1 class="text-4xl md:text-6xl font-bold text-white mb-6">
          Football Blog
        </h1>
        <p class="text-xl md:text-2xl text-blue-100 mb-8">
          Analysis, rankings, and expert commentary on the beautiful game
        </p>
        
        <!-- Category Navigation -->
        <div class="flex flex-wrap justify-center gap-3">
          <a
            href="/blog"
            class="bg-white text-gray-700 px-6 py-3 rounded-lg font-medium shadow-lg"
          >
            All Posts
          </a>
          
          {categories.map((category) => (
            <a
              href={`/category/${slugify(category)}`}
              class="bg-blue-500 bg-opacity-90 text-white px-6 py-3 rounded-lg font-medium hover:bg-blue-600 transition-all duration-200 backdrop-blur-sm shadow-lg"
            >
              {category}
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Ad Slot -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <AdSlot slot="1234567890" className="my-8" />
    </div>

    <!-- Posts Grid -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <div class="flex items-center justify-between mb-8">
        <h2 class="text-3xl font-bold text-gray-900">
          Latest Articles - Page {page}
        </h2>
        <p class="text-gray-600">
          {posts.length} of {allPosts.length} articles
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {posts.map((post) => (
          <article class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-lg transition">
            {post.data.featuredImage ? (
              <img
                src={post.data.featuredImage}
                alt={post.data.title}
                class="w-full h-48 object-cover"
                loading="lazy"
              />
            ) : (
              <div class="h-48 bg-gradient-to-br from-blue-100 to-purple-100 flex items-center justify-center">
                <span class="text-6xl text-blue-300">⚽</span>
              </div>
            )}
            
            <div class="p-6">
              <div class="flex items-center justify-between mb-3">
                <span class="text-sm font-medium text-blue-600 bg-blue-50 px-3 py-1 rounded-full">
                  {post.data.category}
                </span>
                <span class="text-sm text-gray-500">{post.data.readTime} min read</span>
              </div>
              
              <h3 class="text-xl font-bold text-gray-900 mb-3 hover:text-blue-600 transition-colors">
                <a href={`/blog/${post.slug}`}>{post.data.title}</a>
              </h3>
              
              <p class="text-gray-600 mb-4 line-clamp-3">{post.data.description}</p>
              
              <div class="flex items-center justify-between">
                <time class="text-sm text-gray-500" datetime={new Date(post.data.publishedAt).toISOString()}>
                  {new Date(post.data.publishedAt).toLocaleDateString('en-GB')}
                </time>
                <a href={`/blog/${post.slug}`} class="text-blue-600 font-medium hover:text-blue-700">
                  Read More →
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>

      <!-- Pagination -->
      {totalPages > 1 && (
        <div class="flex justify-center items-center space-x-4 mt-12">
          {page > 1 && (
            <a
              href={page === 2 ? "/blog" : `/blog/${page - 1}`}
              class="bg-blue-600 text-white px-6 py-3 rounded-lg font-medium hover:bg-blue-700 transition"
            >
              ← Previous
            </a>
          )}
          
          <div class="flex space-x-2">
            {Array.from({ length: totalPages }, (_, i) => {
              const pageNum = i + 1;
              const isCurrentPage = pageNum === page;
              const href = pageNum === 1 ? "/blog" : `/blog/${pageNum}`;
              
              return (
                <a
                  href={href}
                  class={isCurrentPage
                    ? "bg-blue-600 text-white px-4 py-2 rounded-lg font-medium"
                    : "bg-gray-200 text-gray-700 px-4 py-2 rounded-lg font-medium hover:bg-gray-300 transition"
                  }
                >
                  {pageNum}
                </a>
              );
            })}
          </div>
          
          {page < totalPages && (
            <a
              href={`/blog/${page + 1}`}
              class="bg-blue-600 text-white px-6 py-3 rounded-lg font-medium hover:bg-blue-700 transition"
            >
              Next →
            </a>
          )}
        </div>
      )}
    </section>

    <!-- Ad Slot Bottom -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <AdSlot slot="0987654321" className="my-8" />
    </div>
  </main>
  
  <Footer />
</Layout>