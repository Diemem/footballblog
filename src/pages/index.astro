---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import AdSlot from "../components/AdSlot.astro";

const allPosts = await getCollection("posts");
const sortedPosts = allPosts.sort(
  (a, b) => new Date(b.data.publishedAt).getTime() - new Date(a.data.publishedAt).getTime()
);

const featuredPosts = sortedPosts.filter((post) => post.data.featured).slice(0, 3);
const recentPosts = sortedPosts.slice(0, 6);

// Small helper for date formatting
const formatDate = (d: Date) =>
  d.toLocaleDateString("en-GB", { day: "2-digit", month: "2-digit", year: "numeric" });

// Category -> styles
const categoryStyles = (cat: string) => {
  switch (cat.toLowerCase()) {
    case "analysis":
      return { pill: "bg-emerald-50 text-emerald-700", accent: "text-emerald-700" };
    case "rankings":
      return { pill: "bg-amber-50 text-amber-700", accent: "text-amber-700" };
    case "opinion":
      return { pill: "bg-purple-50 text-purple-700", accent: "text-purple-700" };
    default:
      return { pill: "bg-blue-50 text-blue-700", accent: "text-blue-700" };
  }
};
---

<Layout
  title="Football Central - Analysis, Rankings & Evergreen Football Insights"
  description="Football Central brings clean, evergreen football analysis, rankings, and opinions — designed for fans who love the details."
>
  <Header />

  <main>
    <!-- HERO -->
    <section class="relative overflow-hidden">
      <!-- Background image -->
      <div
        class="absolute inset-0"
        style="
          background-image: url('/images/pexels-eric-masengesho-2154894489-33471345.jpg');
          background-size: cover;
          background-position: center;
        "
      ></div>
      <!-- Overlay for readability -->
      <div class="absolute inset-0 bg-gradient-to-b from-black/65 via-black/55 to-black/70"></div>

      <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16 flex items-center justify-center min-h-[350px]">
        <div class="max-w-3xl text-center">
          <h1 class="text-4xl md:text-6xl font-extrabold text-white leading-tight">
            Analysis, rankings, and football stories that age well.
          </h1>

          <p class="mt-5 text-lg md:text-xl text-white/85 leading-relaxed">
            Clear breakdowns, smart rankings, and opinion pieces — built for fans who want context, not clickbait.
          </p>

          <div class="mt-8 flex flex-wrap gap-3 justify-center">
            <a
              href="/blog"
              class="inline-flex items-center justify-center rounded-xl px-6 py-3 font-semibold bg-white text-gray-900 hover:bg-white/90 transition"
            >
              Read Latest Articles →
            </a>
            <a
              href="/category/analysis"
              class="inline-flex items-center justify-center rounded-xl px-6 py-3 font-semibold border border-white/40 text-white hover:bg-white/10 transition"
            >
              Explore Analysis
            </a>
          </div>

          <!-- Quick category chips -->
          <div class="mt-8 flex flex-wrap gap-2 justify-center">
            <a href="/category/analysis" class="text-sm text-white/85 hover:text-white bg-white/10 border border-white/10 px-3 py-1.5 rounded-full transition">
              📊 Analysis
            </a>
            <a href="/category/rankings" class="text-sm text-white/85 hover:text-white bg-white/10 border border-white/10 px-3 py-1.5 rounded-full transition">
              🏆 Rankings
            </a>
            <a href="/category/opinion" class="text-sm text-white/85 hover:text-white bg-white/10 border border-white/10 px-3 py-1.5 rounded-full transition">
              💭 Opinion
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- TOP AD -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="py-8">
        <AdSlot slot="1234567890" className="my-0" height={250} />
      </div>
    </section>

    <!-- FEATURED -->
    <section class="py-16 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-end justify-between gap-6 flex-wrap mb-10">
          <div>
            <h2 class="text-3xl md:text-4xl font-extrabold text-gray-900">Featured Articles</h2>
            <p class="mt-2 text-gray-600">
              The best place to start — deeper reads with strong takeaways.
            </p>
          </div>

          <a href="/blog" class="text-blue-700 font-semibold hover:text-blue-800 transition">
            View all →
          </a>
        </div>

        {featuredPosts.length > 0 ? (
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {featuredPosts.map((post) => {
              const styles = categoryStyles(post.data.category);
              return (
                <article class="group bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden hover:shadow-lg transition">
                  <a href={`/blog/${post.slug}`} class="block">
                    <div class="relative h-48">
                      {/* If you later add real featured images, replace this div with <img> */}
                      <div
                        class="absolute inset-0"
                        style="
                          background-image: url('/images/pexels-eric-masengesho-2154894489-33471345.jpg');
                          background-size: cover;
                          background-position: center;
                        "
                      ></div>
                      <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/25 to-black/10"></div>

                      <div class="absolute top-4 left-4">
                        <span class={`text-xs font-semibold px-3 py-1 rounded-full ${styles.pill}`}>
                          {post.data.category}
                        </span>
                      </div>

                      <div class="absolute bottom-4 left-4 right-4">
                        <h3 class="text-white font-bold text-lg leading-snug line-clamp-2">
                          {post.data.title}
                        </h3>
                      </div>
                    </div>
                  </a>

                  <div class="p-6">
                    <p class="text-gray-600 line-clamp-3">{post.data.description}</p>

                    <div class="mt-5 flex items-center justify-between text-sm text-gray-500">
                      <span class="inline-flex items-center gap-2">
                        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                          <path
                            fill-rule="evenodd"
                            d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z"
                            clip-rule="evenodd"
                          />
                        </svg>
                        {post.data.readTime} min
                      </span>

                      <span class="inline-flex items-center gap-2">
                        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                          <path
                            fill-rule="evenodd"
                            d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z"
                            clip-rule="evenodd"
                          />
                        </svg>
                        {formatDate(new Date(post.data.publishedAt))}
                      </span>
                    </div>

                    <div class="mt-5">
                      <a
                        href={`/blog/${post.slug}`}
                        class="inline-flex items-center text-blue-700 font-semibold hover:text-blue-800 transition"
                      >
                        Read more →
                      </a>
                    </div>
                  </div>
                </article>
              );
            })}
          </div>
        ) : (
          <div class="rounded-2xl border border-gray-200 bg-gray-50 p-10 text-center">
            <h3 class="text-xl font-bold text-gray-900">No featured posts yet</h3>
            <p class="mt-2 text-gray-600">Mark some posts as featured to show them here.</p>
          </div>
        )}
      </div>
    </section>

    <!-- PASSION / VALUE PROP -->
    <section class="py-16 bg-slate-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
          <div class="relative rounded-2xl overflow-hidden shadow-lg">
            <div
              class="h-96"
              style="
                background-image: url('/images/pexels-eric-masengesho-2154894489-33471345.jpg');
                background-size: cover;
                background-position: center;
              "
            ></div>
            <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/20 to-black/10"></div>
            <div class="absolute bottom-6 left-6 right-6 text-white">
              <h3 class="text-2xl font-bold">Football, explained.</h3>
              <p class="mt-1 text-white/85">
                Tactical breakdowns, ranking logic, and stories with context.
              </p>
            </div>
          </div>

          <div>
            <h2 class="text-3xl md:text-4xl font-extrabold text-gray-900 mb-5">
              The Beautiful Game Lives Here
            </h2>
            <p class="text-gray-600 text-lg leading-relaxed">
              Football is more than just a sport — it’s a shared language. We focus on pieces that stay useful:
              breakdowns, comparisons, and rankings you can revisit anytime.
            </p>

            <div class="mt-7 space-y-4">
              <div class="flex gap-3">
                <div class="w-10 h-10 rounded-xl bg-amber-100 flex items-center justify-center">⚽</div>
                <div>
                  <p class="font-semibold text-gray-900">Match analysis & insights</p>
                  <p class="text-gray-600 text-sm">Clear conclusions without the fluff.</p>
                </div>
              </div>

              <div class="flex gap-3">
                <div class="w-10 h-10 rounded-xl bg-blue-100 flex items-center justify-center">📊</div>
                <div>
                  <p class="font-semibold text-gray-900">Tactical breakdowns</p>
                  <p class="text-gray-600 text-sm">Formations, patterns, and why things happen.</p>
                </div>
              </div>

              <div class="flex gap-3">
                <div class="w-10 h-10 rounded-xl bg-emerald-100 flex items-center justify-center">🏆</div>
                <div>
                  <p class="font-semibold text-gray-900">Rankings that explain themselves</p>
                  <p class="text-gray-600 text-sm">We show the logic behind the list.</p>
                </div>
              </div>
            </div>

            <div class="mt-8 flex flex-wrap gap-3">
              <a
                href="/blog"
                class="inline-flex items-center justify-center rounded-xl px-6 py-3 font-semibold bg-gray-900 text-white hover:bg-gray-800 transition"
              >
                Browse Articles →
              </a>
              <a
                href="/category/analysis"
                class="inline-flex items-center justify-center rounded-xl px-6 py-3 font-semibold border border-gray-300 text-gray-900 hover:bg-white transition"
              >
                View Analysis
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- MIDDLE AD -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="py-10">
        <AdSlot slot="0987654321" className="my-0" height={250} />
      </div>
    </section>

    <!-- LATEST POSTS -->
    <section class="py-16 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-end justify-between gap-6 flex-wrap mb-10">
          <div>
            <h2 class="text-3xl md:text-4xl font-extrabold text-gray-900">Latest Posts</h2>
            <p class="mt-2 text-gray-600">Fresh reads from the blog.</p>
          </div>

          <a href="/blog" class="text-blue-700 font-semibold hover:text-blue-800 transition">
            View all →
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {recentPosts.map((post) => {
            const styles = categoryStyles(post.data.category);
            return (
              <article class="group bg-white rounded-2xl border border-gray-100 shadow-sm hover:shadow-lg transition overflow-hidden">
                <a href={`/blog/${post.slug}`} class="block">
                  <div class="relative h-40">
                    <div
                      class="absolute inset-0"
                      style="
                        background-image: url('/images/pexels-eric-masengesho-2154894489-33471345.jpg');
                        background-size: cover;
                        background-position: center;
                      "
                    ></div>
                    <div class="absolute inset-0 bg-gradient-to-t from-black/55 via-black/20 to-black/10"></div>

                    <div class="absolute top-4 left-4">
                      <span class={`text-xs font-semibold px-3 py-1 rounded-full ${styles.pill}`}>
                        {post.data.category}
                      </span>
                    </div>
                  </div>
                </a>

                <div class="p-6">
                  <h3 class="text-lg font-bold text-gray-900 leading-snug line-clamp-2 group-hover:text-blue-700 transition-colors">
                    <a href={`/blog/${post.slug}`}>{post.data.title}</a>
                  </h3>

                  <p class="mt-3 text-gray-600 line-clamp-3">{post.data.description}</p>

                  <div class="mt-5 flex items-center justify-between text-sm text-gray-500">
                    <span class="inline-flex items-center gap-2">
                      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                        <path
                          fill-rule="evenodd"
                          d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z"
                          clip-rule="evenodd"
                        />
                      </svg>
                      {post.data.readTime} min
                    </span>

                    <span class="inline-flex items-center gap-2">
                      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                        <path
                          fill-rule="evenodd"
                          d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z"
                          clip-rule="evenodd"
                        />
                      </svg>
                      {formatDate(new Date(post.data.publishedAt))}
                    </span>
                  </div>

                  <div class="mt-5">
                    <a href={`/blog/${post.slug}`} class="inline-flex items-center font-semibold text-blue-700 hover:text-blue-800 transition">
                      Read more →
                    </a>
                  </div>
                </div>
              </article>
            );
          })}
        </div>

        <div class="text-center mt-12">
          <a
            href="/blog"
            class="inline-flex items-center justify-center rounded-xl px-7 py-3 font-semibold bg-gray-900 text-white hover:bg-gray-800 transition"
          >
            View All Posts →
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
